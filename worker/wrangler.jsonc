{
  "name": "kate-dev-portfolio-chat",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-29",
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
